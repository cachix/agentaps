---
import MockMessage from './MockMessage.astro';

interface Props {
  prompt: string;
  steps?: string[];
  reply: string;
}

const { prompt, steps = [], reply } = Astro.props;
---

<MockMessage role="user" text={prompt} />
{steps.length > 0 && (
  <div class="app-tools">
    <p class="app-tools-head"><span class="app-mark is-done">✓</span><span class="app-tool-label">Completed</span><span class="app-caret">⌄</span></p>
    <p class:list={['app-tool-row', { 'is-summary': steps.length > 1 }]}>
      <span class="app-mark is-done">✓</span>
      <span class="app-tool-label">{steps.length > 1 ? `${steps.length} completed steps` : steps[0]}</span>
      <span class="app-caret">›</span>
    </p>
  </div>
)}
<MockMessage role="agent" text={reply} />
